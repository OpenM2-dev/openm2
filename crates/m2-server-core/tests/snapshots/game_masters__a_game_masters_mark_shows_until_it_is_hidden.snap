   -> send conn#4 EntityInfo vid=2 Bob empire=1 level=1
   -> send conn#8 EntitySpawn vid=1 (475000, 966100) race=0 speed=150/100 game-master
   -> send conn#8 EntityInfo vid=1 Alice empire=1 level=1
-- alice hides it: she and bob get her EntityUpdate without it
@1000 conn#4 sends SendChat kind=0 "/gm"
   -> send conn#4 Chat kind=1 vid=0 "Your GM mark shows: /gm off hides it."
@1000 conn#4 sends SendChat kind=0 "/gm off"
   -> send conn#4 EntityUpdate vid=1 parts=[0, 0, 0, 0] speed=150/100
   -> send conn#8 EntityUpdate vid=1 parts=[0, 0, 0, 0] speed=150/100
   -> store #15: save #1 at (475000, 966100) played 0s
   -> send conn#4 Chat kind=1 vid=0 "Your GM mark is hidden now."
   -> event: conn#4: game master account 1 on character 1: /gm off
@1000 store answers #15: saved: Ok(())
@1000 conn#4 sends SendChat kind=0 "/gm off"
   -> send conn#4 Chat kind=1 vid=0 "Your GM mark is hidden already."
@1000 conn#4 sends SendChat kind=0 "/gm"
   -> send conn#4 Chat kind=1 vid=0 "Your GM mark is hidden: /gm on shows it."
-- bob has no such command
@1000 conn#8 sends SendChat kind=0 "/gm off"
   -> send conn#8 Chat kind=1 vid=0 "Unknown command gm"
