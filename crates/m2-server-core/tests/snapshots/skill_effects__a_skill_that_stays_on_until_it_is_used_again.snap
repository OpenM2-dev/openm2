   -> send conn#4 EntityUpdate vid=4 parts=[0, 0, 0, 0] speed=150/100
   -> send conn#4 PointsChanged 18=20
   -> send conn#4 Affects
   -> send conn#4 EntitySkills vid=4 skills=[]
