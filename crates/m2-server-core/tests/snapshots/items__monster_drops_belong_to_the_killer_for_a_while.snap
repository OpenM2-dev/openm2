-- alice kills the hopper: its gold and pebbles are hers for 30 s
@4000 conn#2 sends Hit vid=1 skill=0
   -> send conn#2 Damage vid=1 flags=1 amount=26
   -> send conn#2 EntityDied vid=1
   -> send conn#4 EntityDied vid=1
   -> send conn#2 PointsChanged 3=10
   -> send conn#2 Flight kind=0 from=1 to=2
   -> send conn#4 Flight kind=0 from=1 to=2
   -> send conn#2 GroundItemAdd vid=4 1 (475048, 966982)
   -> send conn#2 ItemOwnership vid=4 Alice
   -> send conn#4 GroundItemAdd vid=4 1 (475048, 966982)
   -> send conn#4 ItemOwnership vid=4 Alice
   -> send conn#2 GroundItemAdd vid=5 3005 (474976, 967000)
   -> send conn#2 ItemOwnership vid=5 Alice
   -> send conn#4 GroundItemAdd vid=5 3005 (474976, 967000)
   -> send conn#4 ItemOwnership vid=5 Alice
@4000 conn#4 sends PickUp vid=5
   -> send conn#4 Chat kind=1 vid=0 "That is not yours yet."
-- 30 s on, anyone may take them
@24000 conn#2 sends Pong
@24000 conn#4 sends Pong
@24000 tick
   -> send conn#2 Ping
   -> send conn#4 Ping
   -> send conn#2 EntityRemove vid=1
   -> send conn#4 EntityRemove vid=1
