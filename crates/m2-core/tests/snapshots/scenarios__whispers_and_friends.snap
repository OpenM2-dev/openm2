@400ms Command(ForgetWhispers { name: "ann" })
@500ms Message(ConnId(2), Friends(Friends { friends: [Friend { name: "Bob", online: true }, Friend { name: "Carol", online: false }] }))
    -> Event(Friends)
@510ms Message(ConnId(2), FriendChanged(FriendChanged { name: "Carol", status: 2 }))
    -> Event(FriendChanged { name: "Carol", change: Online })
@520ms Message(ConnId(2), FriendChanged(FriendChanged { name: "Dave", status: 1 }))
