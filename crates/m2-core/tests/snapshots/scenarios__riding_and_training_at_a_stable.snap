---
source: crates/m2-core/tests/scenarios.rs
expression: s.log
---
@0ms Start
    -> Connect { conn: ConnId(1), server: Auth }
@5ms Connected(ConnId(1))
    -> Send { conn: ConnId(1), message: Hello(Hello { protocol: 4, build: "openm2 test" }) }
@6ms Message(ConnId(1), Welcome(Welcome { protocol: 4, server: "openm2-server test" }))
    -> Event(Welcomed { server: Auth, protocol: 4, name: "openm2-server test" })
    -> Send { conn: ConnId(1), message: StartSignIn(StartSignIn) }
@7ms Message(ConnId(1), SignInOptions(SignInOptions { providers: [Provider { id: "example", name: "Example ID", authorize: "https://id.example/authorize", client_id: "openm2" }], nonce: "n0nce", key_sign_in: false }))
    -> Event(SignInOptions(SignInOffer { providers: [SignInProvider { id: "example", name: "Example ID", authorize: "https://id.example/authorize", client_id: "openm2" }], key: false }))
    -> SignIn { provider: SignInProvider { id: "example", name: "Example ID", authorize: "https://id.example/authorize", client_id: "openm2" }, nonce: "n0nce" }
@8ms SignInCode(SignInCode { redirect: "http://127.0.0.1:50000/callback", .. })
    -> Send { conn: ConnId(1), message: ProviderLogin(ProviderLogin { provider: "example", code: <redacted>, verifier: <redacted>, redirect: "http://127.0.0.1:50000/callback" }) }
@20ms Message(ConnId(1), SignedIn(SignedIn { account: "example:admin", ticket: <redacted> }))
    -> Event(LoggedIn)
    -> Disconnect { conn: ConnId(1) }
    -> Connect { conn: ConnId(2), server: Game }
@25ms Connected(ConnId(2))
    -> Send { conn: ConnId(2), message: Hello(Hello { protocol: 4, build: "openm2 test" }) }
@26ms Message(ConnId(2), Welcome(Welcome { protocol: 4, server: "openm2-server test" }))
    -> Event(Welcomed { server: Game, protocol: 4, name: "openm2-server test" })
    -> Send { conn: ConnId(2), message: TicketLogin(TicketLogin { username: "example:admin", ticket: <redacted> }) }
@110ms Message(ConnId(2), Empire(Empire { empire: 2 }))
@110ms Message(ConnId(2), Phase(Phase { phase: 1 }))
    -> Event(Phase { server: Game, phase: Select })
@110ms Message(ConnId(2), CharacterList(CharacterList { characters: [Character { slot: 0, id: 1, name: "Alice", class: 3, level: 10, playtime: 0, st: 0, ht: 0, dx: 0, iq: 0, body_part: 0, hair_part: 0, guild: "" }] }))
    -> Event(CharacterList([CharacterSummary { slot: 0, id: 1, name: "Alice", class: 3, level: 10, playtime: 0, st: 0, ht: 0, dx: 0, iq: 0, body_part: 0, hair_part: 0, guild: "" }]))
    -> Event(Selected { slot: 0, name: "Alice" })
    -> Send { conn: ConnId(2), message: SelectCharacter(SelectCharacter { slot: 0 }) }
@120ms Message(ConnId(2), Phase(Phase { phase: 2 }))
    -> Event(Phase { server: Game, phase: Loading })
@121ms Message(ConnId(2), MainCharacter(MainCharacter { vid: 4660, class: 3, name: "Alice", x: 958400, y: 272800, z: 0, empire: 2, skill_group: 0, run_speed: 450 }))
    -> Send { conn: ConnId(2), message: EnterGame(EnterGame) }
@130ms Message(ConnId(2), Phase(Phase { phase: 3 }))
    -> Event(Phase { server: Game, phase: Game })
    -> Event(EnteredGame(Some(Me { vid: 4660, name: "Alice", class: 3, empire: Chunjo, position: (958400, 272800, 0) })))
@131ms Message(ConnId(2), GameTime(GameTime { time: 10000 }))
@200ms Command(Ride { ride: true })
    -> Event(Ignored { what: "Ride", why: "we have no mount" })
@210ms Message(ConnId(2), EntitySpawn(EntitySpawn { vid: 9100, angle: 90, x: 958400, y: 272800, z: 0, kind: 1, race: 1301, move_speed: 100, attack_speed: 100, state: 0, affects: 0 }))
    -> Event(EntityAppeared { vid: 9100, kind: Npc, race: 1301, at: Point { x: 958400, y: 272800 } })
@220ms Message(ConnId(2), StableOpened(StableOpened { vid: 9100, next: Some(MountOffer { level: 1, grade: 1, look: 1201, move_speed: 180, stamina: 30, rider_level: 0, gold: 100, items: [MountCost { vnum: 2003, count: 2 }], skill_points: 0 }) }))
    -> Event(StableOpened { vid: 9100 })
@230ms Command(TrainMount { vid: 9100 })
    -> Send { conn: ConnId(2), message: TrainMount(TrainMount { vid: 9100 }) }
@230ms Command(TrainMount { vid: 9001 })
    -> Event(Ignored { what: "TrainMount", why: "that stable is not open" })
@240ms Message(ConnId(2), MountState(MountState { level: 1, grade: 1, look: 1201, stamina: 30, most: 30, ride_from: 6, fights: false, skills: false, skill_points: 0, summoned: None }))
    -> Event(MountStateChanged)
@250ms Command(Ride { ride: true })
    -> Send { conn: ConnId(2), message: RideMount(RideMount { ride: true }) }
@260ms Message(ConnId(2), EntityMount(EntityMount { vid: 4660, look: 1201 }))
    -> Event(MountChanged { vid: 4660, look: 1201 })
@260ms Message(ConnId(2), RunSpeed(RunSpeed { run_speed: 800 }))
    -> Event(RunSpeedChanged { run_speed: 800 })
@270ms Command(Attack { angle: 0, combo: 1 })
    -> Event(Ignored { what: "Attack", why: "our mount does not fight" })
@270ms Command(UseSkill { skill: 1, angle: 0, target: None, motion: None, to: None })
    -> Event(Ignored { what: "UseSkill", why: "a job's skills are used on foot" })
@270ms Command(UseSkill { skill: 200, angle: 0, target: None, motion: Some(122), to: None })
    -> Event(Ignored { what: "UseSkill", why: "our mount has no horseback skills" })
@280ms Message(ConnId(2), MountState(MountState { level: 1, grade: 1, look: 1201, stamina: 30, most: 30, ride_from: 6, fights: true, skills: true, skill_points: 0, summoned: None }))
    -> Event(MountStateChanged)
@280ms Message(ConnId(2), Skills(Skills { skills: [SkillState { skill: 200, level: 1, grade: 0, next_read: 0 }] }))
    -> Event(SkillChanged { skill: 200, level: 1, grade: 0 })
@290ms Command(UseSkill { skill: 200, angle: 0, target: None, motion: Some(122), to: Some(Point { x: 959000, y: 272800 }) })
    -> Send { conn: ConnId(2), message: CharacterMove(CharacterMove { kind: 250, argument: 0, angle: 0, x: 959000, y: 272800, time: 10159 }) }
    -> Send { conn: ConnId(2), message: UseSkill(UseSkill { skill: 200, target: None }) }
@300ms Message(ConnId(2), EntityMount(EntityMount { vid: 4660, look: 0 }))
    -> Event(MountChanged { vid: 4660, look: 0 })
@310ms Message(ConnId(2), ShopOpened(ShopOpened { vid: 9100, goods: [] }))
    -> Event(StableClosed)
    -> Event(ShopOpened { vid: 9100 })
