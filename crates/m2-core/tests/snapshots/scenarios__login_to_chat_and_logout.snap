@0ms Start
    -> Connect { conn: ConnId(1), server: Auth }
@5ms Connected(ConnId(1))
    -> Send { conn: ConnId(1), message: Hello(Hello { protocol: 4, build: "openm2 test" }) }
@6ms Message(ConnId(1), Welcome(Welcome { protocol: 4, server: "openm2-server test" }))
    -> Event(Welcomed { server: Auth, protocol: 4, name: "openm2-server test" })
    -> Send { conn: ConnId(1), message: StartSignIn(StartSignIn) }
@7ms Message(ConnId(1), SignInOptions(SignInOptions { providers: [Provider { id: "example", name: "Example ID", authorize: "https://id.example/authorize", client_id: "openm2" }], nonce: "n0nce", key_sign_in: false }))
    -> Event(SignInOptions(SignInOffer { providers: [SignInProvider { id: "example", name: "Example ID", authorize: "https://id.example/authorize", client_id: "openm2" }], key: false }))
    -> SignIn { provider: SignInProvider { id: "example", name: "Example ID", authorize: "https://id.example/authorize", client_id: "openm2" }, nonce: "n0nce" }
@8ms SignInCode(SignInCode { redirect: "http://127.0.0.1:50000/callback", .. })
