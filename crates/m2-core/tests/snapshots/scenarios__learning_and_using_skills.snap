---
source: crates/m2-core/tests/scenarios.rs
expression: s.log
---
@0ms Start
    -> Connect { conn: ConnId(1), server: Auth }
@5ms Connected(ConnId(1))
    -> Send { conn: ConnId(1), message: Hello(Hello { protocol: 3, build: "openm2 test" }) }
@6ms Message(ConnId(1), Welcome(Welcome { protocol: 3, server: "openm2-server test" }))
    -> Event(Welcomed { server: Auth, protocol: 3, name: "openm2-server test" })
    -> Send { conn: ConnId(1), message: StartSignIn(StartSignIn) }
@7ms Message(ConnId(1), SignInOptions(SignInOptions { providers: [Provider { id: "example", name: "Example ID", authorize: "https://id.example/authorize", client_id: "openm2" }], nonce: "n0nce" }))
    -> Event(SignInOptions([SignInProvider { id: "example", name: "Example ID", authorize: "https://id.example/authorize", client_id: "openm2" }]))
    -> SignIn { provider: SignInProvider { id: "example", name: "Example ID", authorize: "https://id.example/authorize", client_id: "openm2" }, nonce: "n0nce" }
@8ms SignInCode(SignInCode { redirect: "http://127.0.0.1:50000/callback", .. })
    -> Send { conn: ConnId(1), message: ProviderLogin(ProviderLogin { provider: "example", code: <redacted>, verifier: <redacted>, redirect: "http://127.0.0.1:50000/callback" }) }
@20ms Message(ConnId(1), SignedIn(SignedIn { account: "example:admin", ticket: <redacted> }))
    -> Event(LoggedIn)
    -> Disconnect { conn: ConnId(1) }
    -> Connect { conn: ConnId(2), server: Game }
@25ms Connected(ConnId(2))
    -> Send { conn: ConnId(2), message: Hello(Hello { protocol: 3, build: "openm2 test" }) }
@26ms Message(ConnId(2), Welcome(Welcome { protocol: 3, server: "openm2-server test" }))
    -> Event(Welcomed { server: Game, protocol: 3, name: "openm2-server test" })
    -> Send { conn: ConnId(2), message: TicketLogin(TicketLogin { username: "example:admin", ticket: <redacted> }) }
@110ms Message(ConnId(2), Empire(Empire { empire: 2 }))
@110ms Message(ConnId(2), Phase(Phase { phase: 1 }))
    -> Event(Phase { server: Game, phase: Select })
@110ms Message(ConnId(2), CharacterList(CharacterList { characters: [Character { slot: 0, id: 1, name: "Alice", class: 3, level: 10, playtime: 0, st: 0, ht: 0, dx: 0, iq: 0, body_part: 0, hair_part: 0, guild: "" }] }))
    -> Event(CharacterList([CharacterSummary { slot: 0, id: 1, name: "Alice", class: 3, level: 10, playtime: 0, st: 0, ht: 0, dx: 0, iq: 0, body_part: 0, hair_part: 0, guild: "" }]))
    -> Event(Selected { slot: 0, name: "Alice" })
    -> Send { conn: ConnId(2), message: SelectCharacter(SelectCharacter { slot: 0 }) }
@120ms Message(ConnId(2), Phase(Phase { phase: 2 }))
    -> Event(Phase { server: Game, phase: Loading })
@121ms Message(ConnId(2), MainCharacter(MainCharacter { vid: 4660, class: 3, name: "Alice", x: 958400, y: 272800, z: 0, empire: 2, skill_group: 0, run_speed: 450 }))
    -> Send { conn: ConnId(2), message: EnterGame(EnterGame) }
@130ms Message(ConnId(2), Phase(Phase { phase: 3 }))
    -> Event(Phase { server: Game, phase: Game })
    -> Event(EnteredGame(Some(Me { vid: 4660, name: "Alice", class: 3, empire: Chunjo, position: (958400, 272800, 0) })))
@131ms Message(ConnId(2), GameTime(GameTime { time: 10000 }))
@140ms Message(ConnId(2), EntitySpawn(EntitySpawn { vid: 4660, angle: 90, x: 958400, y: 272800, z: 0, kind: 6, race: 3, move_speed: 150, attack_speed: 100, state: 0, affects: 0 }))
    -> Event(EntityAppeared { vid: 4660, kind: Player, race: 3, at: Point { x: 958400, y: 272800 } })
@141ms Message(ConnId(2), EntitySpawn(EntitySpawn { vid: 9001, angle: 90, x: 958550, y: 272800, z: 0, kind: 0, race: 101, move_speed: 100, attack_speed: 100, state: 0, affects: 0 }))
    -> Event(EntityAppeared { vid: 9001, kind: Monster, race: 101, at: Point { x: 958550, y: 272800 } })
@142ms Message(ConnId(2), Skills(Skills { skills: [] }))
@150ms Message(ConnId(2), SkillGroup(SkillGroup { group: 1 }))
    -> Event(SkillGroupChanged { group: 1 })
@200ms Command(UseSkill { skill: 91, angle: 90, target: Some(9001), motion: None, to: None })
    -> Event(Ignored { what: "UseSkill", why: "the skill is not learned" })
@200ms Command(UseSkill { skill: 121, angle: 90, target: Some(9001), motion: None, to: None })
    -> Event(Ignored { what: "UseSkill", why: "the skill's motion is not known" })
@205ms Command(RaiseStatus { point: 13 })
    -> Send { conn: ConnId(2), message: RaiseStatus(RaiseStatus { point: 13 }) }
@205ms Command(RaiseStatus { point: 28 })
    -> Event(Ignored { what: "RaiseStatus", why: "only a stat is raised" })
@210ms Command(SkillUp { skill: 91 })
    -> Send { conn: ConnId(2), message: RaiseSkill(RaiseSkill { skill: 91 }) }
@220ms Message(ConnId(2), Skills(Skills { skills: [SkillState { skill: 91, level: 1, grade: 0, next_read: 0 }] }))
    -> Event(SkillChanged { skill: 91, level: 1, grade: 0 })
@221ms Message(ConnId(2), Skills(Skills { skills: [SkillState { skill: 91, level: 1, grade: 0, next_read: 0 }, SkillState { skill: 92, level: 40, grade: 3, next_read: 0 }] }))
    -> Event(SkillChanged { skill: 92, level: 40, grade: 3 })
@300ms Command(UseSkill { skill: 91, angle: 90, target: Some(9001), motion: None, to: None })
    -> Send { conn: ConnId(2), message: CharacterMove(CharacterMove { kind: 129, argument: 0, angle: 90, x: 958400, y: 272800, time: 10169 }) }
    -> Send { conn: ConnId(2), message: UseSkill(UseSkill { skill: 91, target: Some(9001) }) }
@400ms Command(Hit { vid: 9001, skill: 91 })
    -> Send { conn: ConnId(2), message: Hit(Hit { vid: 9001, skill: 91 }) }
@500ms Message(ConnId(2), Skills(Skills { skills: [SkillState { skill: 92, level: 40, grade: 3, next_read: 0 }] }))
    -> Event(SkillChanged { skill: 91, level: 0, grade: 0 })
