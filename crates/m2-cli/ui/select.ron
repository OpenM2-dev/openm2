// The character screens of `openm2 play`: picking a character (its model,
// what the server says about it, the arrows between characters) and making
// one, over the intro background (intro.ron). `@character` is the picture of
// the character that `play` draws. Skins are in skin.ron; the format is in
// docs/specs/ui.md. The ids are what `play` fills in and reads
// (crates/m2-cli/src/interface.rs, `ids`).
(
    windows: [
        (
            id: "select.model",
            anchor: Center,
            pos: (-150, -20),
            size: (400, 560),
            hidden: true,
            click_through: true,
            kind: Image(image: "@character"),
        ),
        (
            id: "select",
            anchor: Bottom,
            // under the character's picture
            pos: (-150, 20),
            size: (560, 110),
            hidden: true,
            click_through: true,
            kind: Group,
            children: [
                (id: "select.left", anchor: TopLeft, pos: (0, 0), size: (160, 36), kind: Button(skin: "dragon_left", text: "")),
                (id: "select.right", anchor: TopRight, pos: (0, 0), size: (160, 36), kind: Button(skin: "dragon_right", text: "")),
                (id: "select.status", anchor: Top, pos: (0, 52), size: (Fill(0), 18),
                 kind: Text(text: "", align: Center, colour: (255, 220, 160, 255))),
                (id: "select.create", anchor: Bottom, pos: (-100, 6), size: (88, 21), kind: Button(skin: "large_button", text: "Create")),
                (id: "select.play", anchor: Bottom, pos: (0, 6), size: (88, 21), kind: Button(skin: "large_button", text: "Play")),
                (id: "select.back", anchor: Bottom, pos: (100, 6), size: (88, 21), kind: Button(skin: "large_button", text: "Back")),
            ],
        ),
        (
            id: "select.info",
            anchor: Right,
            pos: (50, -60),
            size: (260, 244),
            hidden: true,
            kind: Panel(skin: "board"),
            children: [
                (id: "select.title", pos: (12, 12), size: (Fill(12), 21),
                 kind: Text(text: "", align: Center, colour: (255, 230, 170, 255))),
                (pos: (20, 42), size: (90, 18), kind: Text(text: "Name", colour: (200, 180, 140, 255))),
                (id: "select.name", pos: (110, 42), size: (Fill(16), 18), kind: Text(text: "")),
                (pos: (20, 62), size: (90, 18), kind: Text(text: "Class", colour: (200, 180, 140, 255))),
                (id: "select.class", pos: (110, 62), size: (Fill(16), 18), kind: Text(text: "")),
                (pos: (20, 82), size: (90, 18), kind: Text(text: "Level", colour: (200, 180, 140, 255))),
                (id: "select.level", pos: (110, 82), size: (Fill(16), 18), kind: Text(text: "")),
                (pos: (20, 102), size: (90, 18), kind: Text(text: "Empire", colour: (200, 180, 140, 255))),
                (id: "select.empire", pos: (110, 102), size: (Fill(16), 18), kind: Text(text: "")),
                (pos: (20, 122), size: (90, 18), kind: Text(text: "Guild", colour: (200, 180, 140, 255))),
                (id: "select.guild", pos: (110, 122), size: (Fill(16), 18), kind: Text(text: "")),
                (pos: (20, 148), size: (90, 18), kind: Text(text: "Vitality", colour: (200, 180, 140, 255))),
                (id: "select.ht", pos: (110, 148), size: (Fill(16), 18), kind: Text(text: "")),
                (pos: (20, 168), size: (90, 18), kind: Text(text: "Intelligence", colour: (200, 180, 140, 255))),
                (id: "select.iq", pos: (110, 168), size: (Fill(16), 18), kind: Text(text: "")),
                (pos: (20, 188), size: (90, 18), kind: Text(text: "Strength", colour: (200, 180, 140, 255))),
                (id: "select.st", pos: (110, 188), size: (Fill(16), 18), kind: Text(text: "")),
                (pos: (20, 208), size: (90, 18), kind: Text(text: "Dexterity", colour: (200, 180, 140, 255))),
                (id: "select.dx", pos: (110, 208), size: (Fill(16), 18), kind: Text(text: "")),
            ],
        ),
        (
            id: "create",
            anchor: Right,
            pos: (50, -40),
            size: (300, 330),
            hidden: true,
            kind: Panel(skin: "board"),
            children: [
                (pos: (8, 8), size: (Fill(8), 32), kind: Panel(skin: "title_bar"), children: [
                    (size: (Fill(0), 21), kind: Text(text: "New character", align: Center)),
                    // over the X drawn in the bar's right end
                    (id: "create.close", anchor: TopRight, pos: (3, 2), size: (15, 15), kind: Button(skin: "close", text: "")),
                ]),
                (pos: (20, 42), size: (60, 18), kind: Text(text: "Name", colour: (200, 180, 140, 255))),
                (id: "create.name", pos: (80, 42), size: (Fill(20), 18), kind: Edit(skin: "field", max_chars: 24)),
                (id: "create.class_prev", pos: (16, 72), size: (82, 28), kind: Button(skin: "arrow_left", text: "")),
                (id: "create.class", anchor: Top, pos: (0, 72), size: (100, 28), kind: Text(text: "", align: Center)),
                (id: "create.class_next", anchor: TopRight, pos: (16, 72), size: (82, 28), kind: Button(skin: "arrow_right", text: "")),
                (id: "create.gender_prev", pos: (16, 106), size: (82, 28), kind: Button(skin: "arrow_left", text: "")),
                (id: "create.gender", anchor: Top, pos: (0, 106), size: (100, 28), kind: Text(text: "", align: Center)),
                (id: "create.gender_next", anchor: TopRight, pos: (16, 106), size: (82, 28), kind: Button(skin: "arrow_right", text: "")),
                (
                    id: "create.empire",
                    pos: (0, 140),
                    size: (Fill(0), 116),
                    kind: Group,
                    children: [
                        (id: "create.empire_prev", pos: (16, 0), size: (82, 28), kind: Button(skin: "arrow_left", text: "")),
                        (id: "create.empire_name", anchor: Top, size: (100, 28), kind: Text(text: "", align: Center)),
                        (id: "create.empire_next", anchor: TopRight, pos: (16, 0), size: (82, 28), kind: Button(skin: "arrow_right", text: "")),
                        (id: "create.flag_shinsoo", anchor: Top, pos: (0, 34), size: (128, 79),
                         kind: Panel(skin: "flag_shinsoo")),
                        (id: "create.flag_chunjo", anchor: Top, pos: (0, 34), size: (128, 79), hidden: true,
                         kind: Panel(skin: "flag_chunjo")),
                        (id: "create.flag_jinno", anchor: Top, pos: (0, 34), size: (128, 79), hidden: true,
                         kind: Panel(skin: "flag_jinno")),
                    ],
                ),
                (id: "create.status", anchor: Bottom, pos: (0, 48), size: (Fill(12), 18),
                 kind: Text(text: "", align: Center, colour: (255, 200, 120, 255))),
                (id: "create.ok", anchor: Bottom, pos: (-50, 18), size: (88, 21), kind: Button(skin: "large_button", text: "Create")),
                (id: "create.cancel", anchor: Bottom, pos: (50, 18), size: (88, 21), kind: Button(skin: "large_button", text: "Cancel")),
            ],
        ),
    ],
)
